rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public read access ───────────────────────────────────
    // Settings, hero, navigation, SEO — readable by anyone
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /navigation/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /seo/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /statistics/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /courses/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /results/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /achievements/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gallery/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /testimonials/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /faculty/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /announcements/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /whyUs/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Enquiries — write by anyone (contact form), read by admin only
    match /enquiries/{doc} {
      allow create: if true;   // Public can submit enquiries
      allow read, update, delete: if request.auth != null;
    }

    // ── Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
